# ═══════════════════════════════════════════
# AImigo Integration Platform — Environment
# ═══════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Linear ──────────────────────────────
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
LINEAR_DEFAULT_TEAM_ID=

# ── WhatsApp (Meta Cloud API) ───────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aimigo-verify-2024
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Stripe ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── GitHub ──────────────────────────────
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ── Google (OAuth2) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Airtable ────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Jetson (auto-detected) ──────────────
# JETSON_MODE=MAXN
# JETSON_SWAP_SIZE=4G
